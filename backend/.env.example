# Copy to .env and edit. Node 22+ loads it automatically (no dotenv needed).
PORT=4000
NODE_ENV=development

# SQLite file. Use ":memory:" for throw-away runs.
DB_PATH=./data/smartcare.db

# When configured, the backend uses Supabase PostgreSQL instead of SQLite.
# Keep this database password private; do not commit backend/.env.
SUPABASE_DB_URL=

# REQUIRED in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-dev-only

# Required to enroll or verify face descriptors. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key private and back it up securely; losing it makes enrolled descriptors unreadable.
FACE_DESCRIPTOR_KEY=

# Comma-separated frontend origins allowed to call the API. In production, list
# every frontend origin exactly (scheme + host + optional port).
CORS_ORIGIN=http://localhost:3000

# Clinic time zone (all dates/times in the API are clinic-local)
CLINIC_TZ=Asia/Manila

# Optional demo role login endpoint for development and tests.
DEMO_MODE=false

# Seed sample data when the database is empty
SEED_ON_START=true

# Optional local-only administrator account bootstrap. Never set this in production.
BOOTSTRAP_ADMIN_EMAIL=allyssagrace@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=

# PayMongo hosted checkout. Keep both secrets private and set them only on the backend.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,grab_pay,paymaya
FRONTEND_URL=http://localhost:3000

# Set true when served over HTTPS
COOKIE_SECURE=false

# Business rules
SLOT_HOLD_MIN=5
MIN_LEAD_MIN=30
MAX_ADVANCE_DAYS=90
